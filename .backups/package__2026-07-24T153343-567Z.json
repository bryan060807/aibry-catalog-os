{
  "name": "aibry-catalog-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "aibry-catalog": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/tests/*.test.js\"",
    "test:operator-ui": "npm run build && node --test \"dist/tests/operator-ui.test.js\"",
    "test:powershell51": "npm run build && node --test \"dist/tests/windows-lyric-source-compatibility.test.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "catalog": "node dist/src/cli.js",
    "operator-ui": "node dist/src/operator-ui/server.js",
    "operator-ui:dev": "npm run build && node --watch dist/src/operator-ui/server.js",
    "catalog:autopilot:prepare": "npm run build && node dist/src/live-apply/cli.js prepare --package-policy bounded-lyric-source-batch",
    "catalog:autopilot:execute": "npm run build && node dist/src/live-apply/cli.js execute",
    "guarded-live-apply": "node dist/src/live-apply/cli.js",
    "test:guarded-live-apply": "npm run build && node --test \"dist/tests/guarded-live-apply.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.5.0",
    "yaml": "^2.8.1"
  }
}
