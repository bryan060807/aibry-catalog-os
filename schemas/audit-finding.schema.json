{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aibry.local/schemas/audit-finding.schema.json",
  "title": "Audit Finding",
  "type": "object",
  "required": ["findingId", "severity", "sourcePath", "summary", "evidence"],
  "properties": {
    "findingId": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "error"]
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendedAction": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
